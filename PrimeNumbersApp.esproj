<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6453341">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestRoot>src\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <!-- Allows the build (or compile) command to run on Build -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>
  <ItemGroup>
    <None Include="**\*" Exclude="**\bin\**;**\obj\**;**\node_modules\**;**\.angular\**;**\dist\**;**\package-lock.json;**\*.user" />
  </ItemGroup>
</Project>
